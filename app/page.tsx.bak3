          {/* Gov Appointment */}
          <motion.div initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-60px" }} transition={{ duration: 0.8, ease: [0.22, 1, 0.36, 1] }} className="mb-16">
            <div className="glass-card rounded-3xl overflow-hidden border border-white/10 hover:border-purple-500/40 hover-glow transition-all duration-500">
              <div className="grid grid-cols-1 lg:grid-cols-2">
                {/* Content first */}
                <div className="p-8 md:p-10">
                  <span className="text-purple-400 font-mono text-xs font-bold tracking-wider">02 — Full Stack · Academic</span>
                  <h3 className="text-2xl font-bold text-white mt-2 mb-1">Gov Appointment System</h3>
                  <p className="text-neutral-400 text-sm mb-6">Web-Based Appointment Management Platform</p>
                  <p className="text-neutral-400 text-sm leading-relaxed mb-6">
                    A web-based appointment system built to streamline scheduling and record tracking for government services — multiple user roles, structured workflows, and a secure database architecture.
                  </p>
                  <div className="grid grid-cols-2 gap-4 mb-6 text-sm">
                    <div><span className="text-white font-semibold text-xs uppercase tracking-widest block mb-1">My Role</span><span className="text-neutral-400">Full-Stack Dev · DB Designer</span></div>
                    <div><span className="text-white font-semibold text-xs uppercase tracking-widest block mb-1">Stack</span><span className="text-neutral-400">React · Node.js · SQL · REST APIs</span></div>
                  </div>
                  <ul className="space-y-1.5 text-sm text-neutral-400 mb-7">
                    {["Multi-role system (Admin, Staff, Citizen)", "Appointment workflows with status tracking", "Normalized relational database schema", "Formal SRS documentation"].map(p => (
                      <li key={p} className="flex items-start gap-2"><ChevronRight size={14} className="text-purple-500 shrink-0 mt-0.5" />{p}</li>
                    ))}
                  </ul>
                  <a href="/assets/25057-GRP2-SRS-Final.pdf" target="_blank"
                    className="inline-flex items-center text-xs font-bold text-purple-400 hover:text-purple-300 bg-purple-500/10 px-4 py-2 rounded-full border border-purple-500/30 transition-colors">
                    View SRS Document <ExternalLink size={12} className="ml-1.5" />
                  </a>
                </div>
                {/* Laptop */}
                <div className="bg-neutral-900/50 p-8 flex items-center justify-center border-t lg:border-t-0 lg:border-l border-white/5">
                  <LaptopMockup src="/assets/images/gov_screenshot_10.png" alt="Gov System" />
                </div>
              </div>
            </div>
          </motion.div>

          {/* Dr. MK Optical Clinic */}
          <motion.div initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-60px" }} transition={{ duration: 0.8, ease: [0.22, 1, 0.36, 1] }} className="mb-16">
            <div className="glass-card rounded-3xl overflow-hidden border border-white/10 hover:border-purple-500/40 hover-glow transition-all duration-500">
              <div className="grid grid-cols-1 lg:grid-cols-2">
                {/* Visual side — no screenshot, stylized */}
                <div className="bg-neutral-900/50 p-10 flex flex-col items-center justify-center border-b lg:border-b-0 lg:border-r border-white/5 min-h-[280px]">
                  <motion.div animate={{ y: [0, -8, 0] }} transition={{ duration: 3.5, repeat: Infinity, ease: "easeInOut" }}
                    className="bg-white/5 border border-white/10 rounded-2xl p-8 text-center w-full max-w-xs shadow-[0_0_40px_rgba(168,85,247,0.08)]">
                    <span className="text-4xl font-black text-white/40 tracking-tighter block mb-2">MK</span>
                    <span className="text-purple-300 font-mono text-xs tracking-widest font-bold block mb-5">OPTICAL CLINIC</span>
                    <div className="flex flex-col gap-2">
                      {["Patient Records", "Prescriptions", "Encrypted Backup"].map(f => (
                        <span key={f} className="text-xs text-neutral-400 bg-white/5 border border-white/8 rounded-full px-4 py-1.5">{f}</span>
                      ))}
                    </div>
                  </motion.div>
                </div>
                {/* Content */}
                <div className="p-8 md:p-10">
                  <span className="text-purple-400 font-mono text-xs font-bold tracking-wider">03 — Full Stack · Freelance</span>
                  <h3 className="text-2xl font-bold text-white mt-2 mb-1">Dr. M.K. Optical Clinic</h3>
                  <p className="text-neutral-400 text-sm mb-6">Patient Records Management System</p>
                  <p className="text-neutral-400 text-sm leading-relaxed mb-6">
                    A web-based patient records system built for an optical clinic — streamlining patient data, prescriptions, and clinic operations.
                  </p>
                  <div className="grid grid-cols-2 gap-4 mb-6 text-sm">
                    <div><span className="text-white font-semibold text-xs uppercase tracking-widest block mb-1">My Role</span><span className="text-neutral-400">UI Dev · Junior Full-Stack</span></div>
                    <div><span className="text-white font-semibold text-xs uppercase tracking-widest block mb-1">Stack</span><span className="text-neutral-400">HTML · CSS · JS · PHP · MySQL</span></div>
                  </div>
                  <ul className="space-y-1.5 text-sm text-neutral-400">
                    {["Designed and built the full system UI from scratch", "Built encrypted backup & restore functionality"].map(p => (
                      <li key={p} className="flex items-start gap-2"><ChevronRight size={14} className="text-purple-500 shrink-0 mt-0.5" />{p}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </motion.div>

          {/* More Projects grid */}
          <motion.h3 initial="hidden" whileInView="visible" viewport={{ once: true }} variants={fadeIn}
            className="text-xl font-bold text-white mb-6">More Projects</motion.h3>
          <motion.div initial="hidden" whileInView="visible" viewport={{ once: true }} variants={staggerContainer}
