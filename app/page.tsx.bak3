"use client";

import React, { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence, useScroll, useSpring, useTransform, useMotionValue } from 'framer-motion';
import { Terminal, BrainCircuit, Code2, ExternalLink, Mail, Award, Layout, Database, BarChart3, ChevronRight, CheckCircle2, GraduationCap, FileText, X } from 'lucide-react';

/* ─── Magnetic button ─── */
const MagneticBtn = ({ children, className = "", href = "#", target, rel, ...props }: any) => {
  const ref = useRef<HTMLAnchorElement>(null);
  const x = useMotionValue(0);
  const y = useMotionValue(0);
  const handleMouseMove = (e: React.MouseEvent) => {
    const rect = ref.current!.getBoundingClientRect();
    x.set((e.clientX - rect.left - rect.width / 2) * 0.3);
    y.set((e.clientY - rect.top - rect.height / 2) * 0.3);
  };
  const reset = () => { x.set(0); y.set(0); };
  return (
    <motion.a ref={ref} href={href} target={target} rel={rel} style={{ x, y }}
      onMouseMove={handleMouseMove} onMouseLeave={reset}
      transition={{ type: "spring", stiffness: 400, damping: 20 }}
      className={`magnetic-btn ${className}`} {...props}>
      {children}
    </motion.a>
  );
};

/* ─── Floating code snippets for hero sides ─── */
const FloatingCode = ({ side }: { side: 'left' | 'right' }) => {
  const lines = side === 'left'
    ? ["const agnes = {", "  role: 'CS Student',", "  loves: ['code', 'data'],", "  available: true", "};"]
    : ["def predict(X):", "  model.fit(X_train)", "  return model.predict(X)", "# accuracy: 0.94"];
  return (
    <motion.div
      className={`absolute top-1/2 -translate-y-1/2 hidden lg:block ${side === 'left' ? 'left-4 xl:left-12' : 'right-4 xl:right-12'}`}
      initial={{ opacity: 0, x: side === 'left' ? -40 : 40 }}
      animate={{ opacity: 1, x: 0 }}
      transition={{ delay: 1, duration: 0.8 }}
    >
      <motion.div
        animate={{ y: [0, -12, 0] }}
        transition={{ duration: 4, repeat: Infinity, ease: "easeInOut", delay: side === 'left' ? 0 : 1.5 }}
        className="bg-neutral-900/80 backdrop-blur-sm border border-white/8 rounded-xl p-4 font-mono text-xs leading-relaxed shadow-[0_0_30px_rgba(168,85,247,0.08)]"
      >
        {lines.map((line, i) => (
          <div key={i} className={`${line.startsWith('  ') ? 'text-purple-300' : line.startsWith('#') ? 'text-neutral-500 italic' : 'text-neutral-200'} whitespace-nowrap`}>
            {line}
          </div>
        ))}
      </motion.div>
    </motion.div>
  );
};

